        <mxCell id="title" parent="1" vertex="1" style="text;html=1;align=left;fontSize=22;fontStyle=1;verticalAlign=middle;" value="CCIC Weekly Cyber Threat Intelligence — Pipeline &amp; Intelligence Cycle Tracker">
